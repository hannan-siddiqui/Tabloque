{
  "manifest_version": 3,
  "name": " ",
  "version": "1.0.0",
  "description": "Visual, drag-and-drop bookmark manager replacing your Chrome New Tab page with customizable boards and cloud sync.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "commands": {
    "quick-save-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Quickly save active tab to TabLoque"
    }
  },
  "action": {
    "default_title": "TabLoque"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
